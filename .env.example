# Environment
ENVIRONMENT=development
PROJECT_NAME="Mami AI"

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (Frontend URL)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database (Postgres)
POSTGRES_SERVER=postgres
POSTGRES_USER=mami_user
POSTGRES_PASSWORD=mami_pass
POSTGRES_DB=mami_db
POSTGRES_PORT=5432

# Graph Database (Neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mami_graph_pass

# Vector Database (ChromaDB)
CHROMA_DB_HOST=chromadb
CHROMA_DB_PORT=8000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# AI Providers (Fill these in!)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
SERPER_API_KEY=

# Desktop Client Security
DESKTOP_CLIENT_SECRET=change_this_shared_secret
